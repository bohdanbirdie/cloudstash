            "linkId": "link-a",
            "tagId": "tag-ts",
            "suggestedName": "typescript",
            "status": "pending",
            "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
            "suggestedAt": 1767432600000
          }
        ]
      }
    },
    {
      "event": "v1.TagSuggested",
      "args": {
        "id": "sug-2",
        "linkId": "link-a",
        "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
