{
  "about": "AI suggests an existing tag and a new tag for a link; one suggestion is accepted, the other dismissed.",
  "steps": [
    {
      "event": "v2.LinkCreated",
      "args": {
        "createdAt": "2026-01-01T09:30:00.000Z",
        "domain": "example.com",
        "id": "link-a",
        "source": "app",
        "sourceMeta": null,
        "url": "https://example.com/a"
      },
      "expect": {
        "links": [
          {
            "id": "link-a",
            "url": "https://example.com/a",
            "domain": "example.com",
            "status": "unread",
            "source": "app",
            "sourceMeta": null,
            "createdAt": 1767259800000,
            "completedAt": null,
            "deletedAt": null
          }
        ]
      }
    },
    {
      "event": "v1.TagCreated",
      "args": {
        "createdAt": "2026-01-02T09:30:00.000Z",
        "id": "tag-ts",
        "name": "typescript",
        "sortOrder": 1
      },
