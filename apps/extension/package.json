{
  "name": "@cloudstash/extension",
  "version": "0.1.1",
  "private": true,
  "description": "Cloudstash Chrome extension — popup to quick-save links, syncing via Livestore",
  "author": "Bohdan Ptyts",
  "type": "module",
  "scripts": {
    "dev": "WXT_APP_URL=${WXT_APP_URL:-http://127.0.0.1:3000} wxt",
    "build": "wxt build",
    "build:local": "WXT_APP_URL=http://127.0.0.1:3000 wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@livestore/adapter-web": "0.0.0-snapshot-2e4bcfc68f7ddad5696022a10d515a011f5f785a",
    "@livestore/livestore": "0.0.0-snapshot-2e4bcfc68f7ddad5696022a10d515a011f5f785a",
    "@livestore/peer-deps": "0.0.0-snapshot-2e4bcfc68f7ddad5696022a10d515a011f5f785a",
    "@livestore/react": "0.0.0-snapshot-2e4bcfc68f7ddad5696022a10d515a011f5f785a",
    "@livestore/sync-cf": "0.0.0-snapshot-2e4bcfc68f7ddad5696022a10d515a011f5f785a",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.99",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  }
