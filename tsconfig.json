{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "worker-configuration.d.ts",
    "prettier.config.js",
    "vite.config.js"
  ],
  "exclude": [
    "local",
    "vendor",
    "scripts",
    "apps",
    "tools/oxlint-rules/__tests__/fixtures"
  ],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/vitest-plugin/types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "warning",
          "effectFnOpportunity": "warning",
          "globalTimersInEffect": "warning",
          "nestedEffectGenYield": "warning",
          "tryCatchInEffectGen": "warning",
          "unsafeEffectTypeAssertion": "warning"
        }
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@cloudflare/workers-types": [
        "./src/cloudflare-workers-types-bridge.d.ts"
      ],
      "*": ["./*"]
    }
  }
}
