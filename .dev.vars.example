# 1Password template for local development. These references are safe to
# commit; `bun run env:sync` resolves them into the ignored `.dev.vars` file.

# Core authentication (required)
# Keep this origin aligned with the browser and local OAuth/MCP clients.
# Generate BETTER_AUTH_SECRET with: openssl rand -hex 32
BETTER_AUTH_SECRET={{ op://Cloudstash/secrets/local/BETTER_AUTH_SECRET }}
BETTER_AUTH_URL={{ op://Cloudstash/secrets/local/BETTER_AUTH_URL }}

# Google OAuth (required)
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/google
EXTENSION_ID_ALLOWLIST={{ op://Cloudstash/secrets/shared/EXTENSION_ID_ALLOWLIST }}
GOOGLE_CLIENT_ID={{ op://Cloudstash/secrets/shared/GOOGLE_CLIENT_ID }}
GOOGLE_CLIENT_SECRET={{ op://Cloudstash/secrets/shared/GOOGLE_CLIENT_SECRET }}

# AI chat, summaries, and enrichment (optional)
# Create a local-only key at https://openrouter.ai/keys
OPENROUTER_API_KEY={{ op://Cloudstash/secrets/local/OPENROUTER_API_KEY }}

# Approval and invite email (optional)
# Create at https://resend.com/api-keys; the sender domain must be verified.
RESEND_API_KEY={{ op://Cloudstash/secrets/shared/RESEND_API_KEY }}
# Local has no EMAIL_FROM field; Wrangler supplies the checked-in default.

# X bookmark sync (optional)
# Use an OAuth 2.0 confidential client with read permission.
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/x
X_CLIENT_ID={{ op://Cloudstash/secrets/local/X_CLIENT_ID }}
X_CLIENT_SECRET={{ op://Cloudstash/secrets/local/X_CLIENT_SECRET }}

# Telegram bot (optional)
# Create a separate local bot with @BotFather.
# Generate TELEGRAM_WEBHOOK_SECRET with: openssl rand -hex 32
TELEGRAM_BOT_TOKEN={{ op://Cloudstash/secrets/local/TELEGRAM_BOT_TOKEN }}
TELEGRAM_WEBHOOK_SECRET={{ op://Cloudstash/secrets/local/TELEGRAM_WEBHOOK_SECRET }}

# Stripe billing (optional; use test-mode resources only)
# Keep the API key, webhook secret, and all price IDs in the same test account.
STRIPE_API_KEY={{ op://Cloudstash/secrets/nonproduction/STRIPE_API_KEY }}
# Endpoint-specific; populate after adding a dedicated local webhook secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS={{ op://Cloudstash/secrets/nonproduction/STRIPE_PRICE_PLUS }}
STRIPE_PRICE_PLUS_YEARLY={{ op://Cloudstash/secrets/nonproduction/STRIPE_PRICE_PLUS_YEARLY }}
STRIPE_PRICE_PRO={{ op://Cloudstash/secrets/nonproduction/STRIPE_PRICE_PRO }}
STRIPE_PRICE_PRO_YEARLY={{ op://Cloudstash/secrets/nonproduction/STRIPE_PRICE_PRO_YEARLY }}

# Admin usage analytics (optional)
CF_ACCOUNT_ID={{ op://Cloudstash/secrets/shared/CF_ACCOUNT_ID }}
CF_ANALYTICS_TOKEN={{ op://Cloudstash/secrets/shared/CF_ANALYTICS_TOKEN }}

# Normally leave PUBLIC_URL unset locally so links use the incoming request
# origin (including a tunnel origin used for Telegram webhook testing).

# Test-only email/password auth. Never enable in staging or production.
# ENABLE_TEST_AUTH=true
