{
  "name": "cloudstash",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build-storybook": "CLOUDSTASH_STORYBOOK=1 storybook build",
    "env:sync": "bash scripts/sync-dev-vars.sh",
    "dev": "vp dev --port 3000 --host",
    "dev:published": "LIVESTORE_PUBLISHED=1 bun run dev",
    "dev:infra": "bun run --parallel dev:tunnel dev:dashboard dev:raycast",
    "motel:tui": "bunx @kitlangton/motel",
    "motel:stop": "bunx @kitlangton/motel stop",
    "email:dev": "email dev -d src/cf-worker/email/templates -p 3001",
    "dev:tunnel": "bun scripts/telegram-tunnel.ts",
    "dev:raycast": "test -d local/raycast-extension || exit 0; npm --prefix local/raycast-extension run dev",
    "sync": "bash scripts/sync-repos.sh",
    "brand:export": "bun scripts/export-brand-assets.ts",
    "storybook": "CLOUDSTASH_STORYBOOK=1 storybook dev -p 7878",
    "livestore:install": "bash scripts/ensure-livestore.sh",
    "dev:dashboard": "localflare attach --no-open",
    "build": "bash scripts/ensure-livestore.sh && vp build && bun scripts/verify-bundle.ts && bun scripts/prerender.tsx",
    "build:prod": "LIVESTORE_VENDOR_MINIMAL=1 bash scripts/ensure-livestore.sh && wrangler d1 migrations apply DB --remote && vp build && bun scripts/verify-bundle.ts",
    "build:staging": "LIVESTORE_VENDOR_MINIMAL=1 CLOUDFLARE_ENV=staging bun run build",
    "preview": "vp preview",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy --keep-vars",
    "deploy:staging": "bun run build:staging && bun run deploy:staging:artifact",
    "deploy:staging:artifact": "bun scripts/verify-staging-artifact.ts && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging --keep-vars",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:generate": "drizzle-kit generate && bun scripts/check-migrations.ts --record-new",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:studio": "drizzle-kit studio --config drizzle-studio.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage --coverage.reporter=text --coverage.reportOnFailure",
    "test:e2e": "mkdir -p dist && vitest run --config vitest.e2e.config.ts",
    "test:bundle": "node scripts/smoke-worker-bundle.ts",
    "test:ext": "bun run --cwd apps/extension test",
    "cf-typegen": "wrangler types --no-include-runtime",
    "typecheck": "tsc --noEmit",
    "check": "vp check && bun run check:effect && bun run check:intent && bun run check:migrations",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --format pretty --strict --lspconfig '{\"allowedDuplicatedPackages\": [\"@livestore/utils\"]}'",
    "check:intent": "vitest run tools/intent/__tests__/intent.test.ts",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:pricing": "bun scripts/check-pricing.ts",
    "fix": "vp check --fix",
    "prepare": "effect-tsgo patch",
    "clean:local-state": "rm -rf .wrangler/state/v3/cache .wrangler/state/v3/do .wrangler/state/v3/kv .wrangler/state/v3/workflows"
  },
